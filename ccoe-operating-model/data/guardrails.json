{
 "version": "1.0",
 "guardrails": [
  {
   "id": "G-IAM-001",
   "title": "No IAM users with long-lived access keys; use federated SSO",
   "domain": "Identity",
   "layer": "detective",
   "severity": "mandatory",
   "controls": [
    "NIST-800-53:IA-5",
    "CIS-AWS:1.14",
    "SOC2:CC6.1",
    "ISO27001:A.5.17"
   ],
   "check": null,
   "remediation": "Use IAM Identity Center permission sets; delete access keys."
  },
  {
   "id": "G-IAM-002",
   "title": "No IAM policy granting Action * on Resource *",
   "domain": "Identity",
   "layer": "proactive",
   "severity": "mandatory",
   "controls": [
    "NIST-800-53:AC-6",
    "CIS-AWS:1.16",
    "SOC2:CC6.3",
    "ISO27001:A.8.2"
   ],
   "check": {
    "type": "iam_no_wildcard_admin"
   },
   "remediation": "Scope actions and resources to least privilege."
  },
  {
   "id": "G-DATA-001",
   "title": "S3 buckets must block all public access",
   "domain": "Data Protection",
   "layer": "proactive",
   "severity": "mandatory",
   "controls": [
    "NIST-800-53:AC-3",
    "CIS-AWS:2.1.4",
    "PCI-DSS:1.4",
    "NDPA-2023:Security"
   ],
   "check": {
    "type": "attrs_true",
    "resource_types": [
     "aws_s3_bucket_public_access_block"
    ],
    "attrs": [
     "block_public_acls",
     "block_public_policy",
     "ignore_public_acls",
     "restrict_public_buckets"
    ]
   },
   "remediation": "Enable all four public access block settings."
  },
  {
   "id": "G-DATA-002",
   "title": "EBS volumes must be encrypted",
   "domain": "Data Protection",
   "layer": "proactive",
   "severity": "mandatory",
   "controls": [
    "NIST-800-53:SC-28",
    "CIS-AWS:2.2.1",
    "PCI-DSS:3.5",
    "ISO27001:A.8.24"
   ],
   "check": {
    "type": "attrs_true",
    "resource_types": [
     "aws_ebs_volume"
    ],
    "attrs": [
     "encrypted"
    ]
   },
   "remediation": "Set encrypted = true with a CMK."
  },
  {
   "id": "G-DATA-003",
   "title": "RDS instances must use storage encryption",
   "domain": "Data Protection",
   "layer": "proactive",
   "severity": "mandatory",
   "controls": [
    "NIST-800-53:SC-28",
    "CIS-AWS:2.3.1",
    "PCI-DSS:3.5",
    "NDPA-2023:Security"
   ],
   "check": {
    "type": "attrs_true",
    "resource_types": [
     "aws_db_instance"
    ],
    "attrs": [
     "storage_encrypted"
    ]
   },
   "remediation": "Set storage_encrypted = true."
  },
  {
   "id": "G-KMS-001",
   "title": "KMS keys must have automatic rotation enabled",
   "domain": "Data Protection",
   "layer": "proactive",
   "severity": "mandatory",
   "controls": [
    "NIST-800-53:SC-12",
    "CIS-AWS:3.6",
    "ISO27001:A.8.24"
   ],
   "check": {
    "type": "attrs_true",
    "resource_types": [
     "aws_kms_key"
    ],
    "attrs": [
     "enable_key_rotation"
    ]
   },
   "remediation": "Set enable_key_rotation = true."
  },
  {
   "id": "G-NET-001",
   "title": "No ingress from 0.0.0.0/0 to SSH (22) or RDP (3389)",
   "domain": "Network",
   "layer": "proactive",
   "severity": "mandatory",
   "controls": [
    "NIST-800-53:SC-7",
    "CIS-AWS:5.2",
    "PCI-DSS:1.3",
    "SOC2:CC6.6"
   ],
   "check": {
    "type": "no_open_ingress",
    "ports": [
     22,
     3389
    ]
   },
   "remediation": "Use SSM Session Manager or a bastion CIDR."
  },
  {
   "id": "G-NET-002",
   "title": "EC2 instances must not auto-assign public IPs",
   "domain": "Network",
   "layer": "proactive",
   "severity": "mandatory",
   "controls": [
    "NIST-800-53:SC-7",
    "PCI-DSS:1.4",
    "ISO27001:A.8.20"
   ],
   "check": {
    "type": "attr_not_eq",
    "resource_types": [
     "aws_instance"
    ],
    "path": "associate_public_ip_address",
    "value": true
   },
   "remediation": "Place workloads in private subnets behind a load balancer."
  },
  {
   "id": "G-LOG-001",
   "title": "CloudTrail must be multi-region with log file validation",
   "domain": "Logging",
   "layer": "proactive",
   "severity": "mandatory",
   "controls": [
    "NIST-800-53:AU-2",
    "CIS-AWS:3.1",
    "SOC2:CC7.2",
    "ISO27001:A.8.15"
   ],
   "check": {
    "type": "attrs_true",
    "resource_types": [
     "aws_cloudtrail"
    ],
    "attrs": [
     "is_multi_region_trail",
     "enable_log_file_validation"
    ]
   },
   "remediation": "Enable both settings; ship to Log Archive account."
  },
  {
   "id": "G-HARD-001",
   "title": "EC2 must require IMDSv2",
   "domain": "Platform Hardening",
   "layer": "proactive",
   "severity": "mandatory",
   "controls": [
    "NIST-800-53:CM-6",
    "CIS-AWS:5.6",
    "SOC2:CC6.8"
   ],
   "check": {
    "type": "attr_eq",
    "resource_types": [
     "aws_instance"
    ],
    "path": "metadata_options.0.http_tokens",
    "value": "required"
   },
   "remediation": "Set metadata_options.http_tokens = required."
  },
  {
   "id": "G-ORG-001",
   "title": "Deny leaving the AWS Organization",
   "domain": "Governance & Org",
   "layer": "preventive",
   "severity": "mandatory",
   "controls": [
    "NIST-800-53:CM-5",
    "SOC2:CC6.1"
   ],
   "check": null,
   "remediation": "SCP: policies/aws-scp/deny-leave-org.json"
  },
  {
   "id": "G-ORG-002",
   "title": "Deny use of the root user in member accounts",
   "domain": "Governance & Org",
   "layer": "preventive",
   "severity": "mandatory",
   "controls": [
    "NIST-800-53:AC-6",
    "CIS-AWS:1.7",
    "ISO27001:A.8.2"
   ],
   "check": null,
   "remediation": "SCP: policies/aws-scp/deny-root-user.json"
  },
  {
   "id": "G-ORG-003",
   "title": "Protect security tooling (CloudTrail, Config, GuardDuty)",
   "domain": "Governance & Org",
   "layer": "preventive",
   "severity": "mandatory",
   "controls": [
    "NIST-800-53:AU-9",
    "SOC2:CC7.2",
    "ISO27001:A.8.15"
   ],
   "check": null,
   "remediation": "SCP: policies/aws-scp/protect-security-tooling.json"
  },
  {
   "id": "G-REG-001",
   "title": "Resources only in approved regions (data residency)",
   "domain": "Governance & Org",
   "layer": "preventive",
   "severity": "mandatory",
   "controls": [
    "NDPA-2023:Security",
    "ISO27001:A.5.34",
    "SOC2:CC6.1"
   ],
   "check": {
    "type": "allowed_regions",
    "regions": [
     "eu-west-1",
     "eu-west-2",
     "eu-central-1",
     "af-south-1",
     "us-east-1"
    ]
   },
   "remediation": "SCP: policies/aws-scp/region-allow-list.json; fix provider region."
  },
  {
   "id": "G-TAG-001",
   "title": "Mandatory tags: owner, cost-center, environment, data-classification",
   "domain": "Cost & Tagging",
   "layer": "proactive",
   "severity": "mandatory",
   "controls": [
    "SOC2:CC2.1",
    "ISO27001:A.5.9",
    "NIST-800-53:CM-8"
   ],
   "check": {
    "type": "required_tags",
    "tags": [
     "owner",
     "cost-center",
     "environment",
     "data-classification"
    ],
    "resource_types": [
     "aws_instance",
     "aws_ebs_volume",
     "aws_db_instance",
     "aws_s3_bucket",
     "aws_kms_key",
     "aws_lambda_function",
     "aws_vpc"
    ]
   },
   "remediation": "Add tags or set provider default_tags."
  },
  {
   "id": "G-COST-001",
   "title": "Prefer gp3 over gp2 volumes",
   "domain": "Cost & Tagging",
   "layer": "proactive",
   "severity": "advisory",
   "controls": [
    "FinOps-Foundation:Optimize"
   ],
   "check": {
    "type": "attr_not_eq",
    "resource_types": [
     "aws_ebs_volume"
    ],
    "path": "type",
    "value": "gp2"
   },
   "remediation": "Use gp3: ~20% cheaper per GB, tunable IOPS."
  }
 ]
}